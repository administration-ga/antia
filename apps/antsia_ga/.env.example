# antsia.ga — variables de l'application (NOMS seulement : le dépôt est public).
#
# En DÉVELOPPEMENT, rien à poser ici : la configuration commune
# (@antsia/api/next-config) lit le déploiement Convex courant dans ANTSIA/.env.local,
# que `bun run dev:convex` écrit lui-même.
# En PRODUCTION, ces valeurs arrivent par les ARG du Dockerfile (deploy/catalog.json).

# URL du déploiement Convex (client navigateur) — inscrite dans le bundle au build.
NEXT_PUBLIC_CONVEX_URL=
# URL des actions HTTP du déploiement (proxy d'authentification, côté serveur).
CONVEX_SITE_URL=
# Origine publique de l'application (liens absolus, métadonnées de partage).
NEXT_PUBLIC_SITE_URL=
# Serveur média des appels (URL de signalisation LiveKit, wss://…) : ouvre son origine
# dans la CSP (lue au build par la configuration commune). Même valeur que
# LIVEKIT_WS_URL du déploiement Convex.
LIVEKIT_WS_URL=
# Commit construit, affiché par /sante-fonctionnelle.
NEXT_PUBLIC_BUILD_SHA=
