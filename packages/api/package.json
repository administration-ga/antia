{
  "name": "@antsia/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Accès des applications au moteur : client Convex + TanStack, session Better Auth, NetworkProvider (réseau courant), adaptateur de routage, passage entre applications.",
  "exports": {
    ".": "./src/index.ts",
    "./csp": "./csp.mjs",
    "./next-config": "./next-config.mjs",
    "./stable-convex-better-auth-provider": "./src/stable-convex-better-auth-provider.tsx",
    "./next-provider": "./src/next-provider.tsx",
    "./network": "./src/network.tsx",
    "./viewer-preferences": "./src/viewer-preferences.tsx",
    "./routing": "./src/routing/index.ts",
    "./routing/next": "./src/routing/adapters/next.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@antsia/social-contracts": "workspace:*",
    "@antsia/social-domain": "workspace:*",
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/react-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "convex": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@antsia/eslint-config": "workspace:*",
    "@antsia/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
