{
  "name": "@antia/social-contracts",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Types et modules purs partagés entre le backend du moteur et les applications (médias, pièces jointes, capacités, codes d'erreur et leurs traductions).",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
