{
  "name": "@antia/social-domain",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "SSOT du moteur social : règles pures (réseaux, adhésions, visibilité, badges, validation des contenus). TypeScript pur, zéro dépendance d'exécution.",
